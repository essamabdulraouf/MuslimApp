<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MuslimApp.Mobile.Components.Common.StateMessageView"
             x:Name="Root">

  <VerticalStackLayout Padding="24"
                       Spacing="{StaticResource Spacing12}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">

    <Label Style="{StaticResource Icon}"
           FontSize="48"
           Opacity="0.7"
           Text="{Binding Glyph, Source={x:Reference Root}}"
           HorizontalOptions="Center" />

    <Label Style="{StaticResource H3}"
           Text="{Binding TitleText, Source={x:Reference Root}}"
           HorizontalTextAlignment="Center" />

    <Label Style="{StaticResource Caption}"
           Text="{Binding BodyText, Source={x:Reference Root}}"
           HorizontalTextAlignment="Center" />

    <Button Style="{StaticResource SecondaryButton}"
            Margin="0,8,0,0"
            HorizontalOptions="Center"
            IsVisible="{Binding HasAction, Source={x:Reference Root}}"
            Text="{Binding ActionText, Source={x:Reference Root}}"
            Command="{Binding ActionCommand, Source={x:Reference Root}}" />

  </VerticalStackLayout>

</ContentView>
