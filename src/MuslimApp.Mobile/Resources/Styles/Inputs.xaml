<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Style x:Key="TextEntry" TargetType="Entry">
    <Setter Property="FontFamily" Value="Tajawal" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
    <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurfaceColor}, Dark={StaticResource DarkSurfaceColor}}" />
    <Setter Property="HeightRequest" Value="{StaticResource MinimumTouchTarget}" />
  </Style>

  <Style x:Key="Picker" TargetType="Picker">
    <Setter Property="FontFamily" Value="Tajawal" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
    <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}" />
    <Setter Property="BackgroundColor" Value="{StaticResource TransparentColor}" />
    <Setter Property="HeightRequest" Value="{StaticResource MinimumTouchTarget}" />
  </Style>

  <Style x:Key="Toggle" TargetType="Switch">
    <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}" />
    <Setter Property="ThumbColor" Value="{StaticResource OnPrimaryColor}" />
  </Style>

  <Style x:Key="Slider" TargetType="Slider">
    <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}" />
    <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource LightBorderColor}, Dark={StaticResource DarkBorderColor}}" />
    <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}" />
  </Style>

  <Style x:Key="BusyIndicator" TargetType="ActivityIndicator">
    <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}" />
    <Setter Property="HeightRequest" Value="32" />
    <Setter Property="WidthRequest" Value="32" />
  </Style>

  <!-- A whole settings row is one target, so the label is as tappable as the control beside it. -->
  <Style x:Key="SettingRow" TargetType="Grid">
    <Setter Property="ColumnSpacing" Value="{StaticResource Spacing12}" />
    <Setter Property="MinimumHeightRequest" Value="{StaticResource MinimumTouchTarget}" />
    <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
  </Style>

</ResourceDictionary>
