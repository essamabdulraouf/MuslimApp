<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Tajawal is the Arabic face and carries the interface; Amiri is reserved for Quranic text, which is never
  set in the interface font. Sizes are not capped so the platform's large-text setting scales them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Style x:Key="BaseLabel" TargetType="Label">
    <Setter Property="FontFamily" Value="Tajawal" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
    <Setter Property="LineBreakMode" Value="WordWrap" />
  </Style>

  <Style x:Key="H1" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="TajawalBold" />
    <Setter Property="FontSize" Value="28" />
  </Style>

  <Style x:Key="H2" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="TajawalBold" />
    <Setter Property="FontSize" Value="24" />
  </Style>

  <Style x:Key="H3" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="TajawalMedium" />
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style x:Key="Body" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="BodyStrong" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="TajawalMedium" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}" />
  </Style>

  <Style x:Key="Small" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextSecondaryColor}, Dark={StaticResource DarkTextSecondaryColor}}" />
  </Style>

  <!--
    A countdown or clock time. Tabular figures keep the digits from shifting as the seconds tick, which is
    otherwise very visible on the home screen.
  -->
  <Style x:Key="TimeDisplay" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="TajawalBold" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="CharacterSpacing" Value="1" />
  </Style>

  <Style x:Key="TimeValue" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="TajawalMedium" />
    <Setter Property="FontSize" Value="17" />
  </Style>

  <!-- Quranic text. Never restyled, never substituted with the interface font. -->
  <Style x:Key="QuranText" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
    <Setter Property="FontFamily" Value="Amiri" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="HorizontalTextAlignment" Value="Center" />
    <Setter Property="LineHeight" Value="1.9" />
  </Style>

  <!-- Material Symbols glyph, used wherever the app shows an icon. -->
  <Style x:Key="Icon" TargetType="Label">
    <Setter Property="FontFamily" Value="MaterialIcons" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="HorizontalTextAlignment" Value="Center" />
    <Setter Property="VerticalTextAlignment" Value="Center" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimaryColor}, Dark={StaticResource DarkTextPrimaryColor}}" />
  </Style>

  <Style x:Key="IconAccent" TargetType="Label" BasedOn="{StaticResource Icon}">
    <Setter Property="TextColor" Value="{StaticResource AccentColor}" />
  </Style>

  <Style x:Key="IconPrimary" TargetType="Label" BasedOn="{StaticResource Icon}">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}" />
  </Style>

</ResourceDictionary>
