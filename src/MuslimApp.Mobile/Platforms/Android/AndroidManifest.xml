<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true" />

  <!--
    Coarse location is enough: prayer times and the qibla bearing do not change meaningfully within a city, so
    the app asks for the least precise permission that does the job. Fine location is deliberately not declared.
  -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!-- Android 13 and later require this before any notification can be shown. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Internet is used only for optional work: turning coordinates into a city name for display, and downloading
    content packages. No feature requires it, and the app is fully functional offline.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
