<?xml version="1.0" encoding="utf-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:pages="clr-namespace:MuslimApp.Mobile.Pages"
               xmlns:loc="clr-namespace:MuslimApp.Mobile.Localization"
               xmlns:vm="clr-namespace:MuslimApp.Mobile.ViewModels"
               xmlns:items="clr-namespace:MuslimApp.Mobile.ViewModels.Items"
               x:Class="MuslimApp.Mobile.Pages.Settings.LocationPage"
               x:DataType="vm:LocationViewModel"
               Title="{loc:Translate Settings_Location}">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="{StaticResource Spacing12}">

    <Border Grid.Row="0" Style="{StaticResource CardFlat}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Spacing12}">
        <Label Grid.Column="0" Style="{StaticResource IconPrimary}" FontSize="20" Text="{StaticResource IconLocationOn}" />
        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Spacing4}">
          <Label Style="{StaticResource Caption}" Text="{loc:Translate Settings_Location}" />
          <Label Style="{StaticResource BodyStrong}" Text="{Binding CurrentLocationName}" />
        </VerticalStackLayout>
      </Grid>
    </Border>

    <Button Grid.Row="1"
            Style="{StaticResource PrimaryButton}"
            Text="{loc:Translate Onboarding_UseMyLocation}"
            Command="{Binding UseMyLocationCommand}"
            IsEnabled="{Binding IsWorking, Converter={StaticResource Invert}}" />

    <Label Grid.Row="2"
           Style="{StaticResource ErrorLabel}"
           HorizontalTextAlignment="Start"
           IsVisible="{Binding HasNotice}"
           Text="{Binding NoticeKey, Converter={StaticResource Translate}}" />

    <SearchBar Grid.Row="3"
               Text="{Binding CitySearch}"
               Placeholder="{loc:Translate Onboarding_ChooseCity}"
               FontFamily="Tajawal" />

    <CollectionView Grid.Row="4" ItemsSource="{Binding Cities}" SelectionMode="None">
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="items:CityItem">
          <Border Style="{StaticResource ListItemCard}" Margin="0,0,0,8">
            <Border.GestureRecognizers>
              <TapGestureRecognizer
                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationViewModel}}, Path=SelectCityCommand}"
                  CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Spacing12}">
              <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource IconLocationCity}" />
              <Label Grid.Column="1" Style="{StaticResource BodyStrong}" Text="{Binding Name}" VerticalTextAlignment="Center" />
              <Label Grid.Column="2" Style="{StaticResource Small}" Text="{Binding Alternate}" VerticalTextAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

  </Grid>

</pages:AppPage>
