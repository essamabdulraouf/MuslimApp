<?xml version="1.0" encoding="utf-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:pages="clr-namespace:MuslimApp.Mobile.Pages"
               xmlns:loc="clr-namespace:MuslimApp.Mobile.Localization"
               xmlns:vm="clr-namespace:MuslimApp.Mobile.ViewModels"
               x:Class="MuslimApp.Mobile.Pages.More.MorePage"
               x:DataType="vm:MoreViewModel"
               Title="{loc:Translate More_Title}">

  <ScrollView>
    <VerticalStackLayout Style="{StaticResource PageContent}">

      <Border Style="{StaticResource ListItemCard}">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Spacing12}">
          <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource IconSettings}" />
          <Label Grid.Column="1" Style="{StaticResource Body}" Text="{loc:Translate More_Settings}" VerticalTextAlignment="Center" />
          <Label Grid.Column="2" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource IconChevronNext}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ListItemCard}">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding OpenTasbihCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Spacing12}">
          <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource IconTasbih}" />
          <Label Grid.Column="1" Style="{StaticResource Body}" Text="{loc:Translate More_Tasbih}" VerticalTextAlignment="Center" />
          <Label Grid.Column="2" Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource IconChevronNext}" />
        </Grid>
      </Border>

      <!--
        Notifications and adhan audio are listed as disabled rather than hidden, so the roadmap is visible and
        no row silently does nothing when tapped.
      -->
      <Border Style="{StaticResource ListItemCard}" Opacity="0.5">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Spacing12}">
          <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource IconNotifications}" />
          <Label Grid.Column="1" Style="{StaticResource Body}" Text="{loc:Translate More_Notifications}" VerticalTextAlignment="Center" />
          <Label Grid.Column="2" Style="{StaticResource Small}" Text="{loc:Translate ComingSoon_Title}" VerticalTextAlignment="Center" />
        </Grid>
      </Border>

      <Border Style="{StaticResource ListItemCard}" Opacity="0.5">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Spacing12}">
          <Label Grid.Column="0" Style="{StaticResource Icon}" FontSize="20" Text="{StaticResource IconAdhan}" />
          <Label Grid.Column="1" Style="{StaticResource Body}" Text="{loc:Translate More_Adhan}" VerticalTextAlignment="Center" />
          <Label Grid.Column="2" Style="{StaticResource Small}" Text="{loc:Translate ComingSoon_Title}" VerticalTextAlignment="Center" />
        </Grid>
      </Border>

      <Border Style="{StaticResource CardFlat}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Spacing12}">
          <Label Grid.Column="0" Style="{StaticResource IconPrimary}" FontSize="20" Text="{StaticResource IconAbout}" />
          <Label Grid.Column="1" Style="{StaticResource Caption}" Text="{loc:Translate Settings_PrivacyNote}" />
        </Grid>
      </Border>

    </VerticalStackLayout>
  </ScrollView>

</pages:AppPage>
